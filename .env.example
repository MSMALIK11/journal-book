# Use a rotated MongoDB credential. Never commit the real URI.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/trading-book?retryWrites=true&w=majority

# Generate at least 32 random bytes, for example: openssl rand -base64 48
JWT_SECRET=replace-with-a-strong-random-secret

# Telegram Bot API token from @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=

# Destination chat for alerts. Supergroup/channel IDs from t.me/c/123 use -100123.
TELEGRAM_CHAT_ID=

# AES-256 key material for encrypting per-user broker API secrets (min 32 chars).
ENCRYPTION_KEY=replace-with-at-least-32-characters-for-aes-key-material

# Delta Exchange demo (India testnet) — keys from https://demo.delta.exchange/app/account/manageapikeys
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org
# Optional server-wide demo override (skips per-user stored keys when both are set):
# DELTA_API_KEY=
# DELTA_API_SECRET=
# DELTA_PRODUCT_MAP_JSON={"BTCUSD":27}
# DELTA_FALLBACK_PRODUCT_ID=27
DELTA_TEST_ORDER_MAX_SIZE=100
# DELTA_MAX_ACCOUNTS=10

# Delta Exchange live (India production) — keys from https://www.delta.exchange/app/account/manageapikeys
# Optional hard kill switch — set to false to block all live orders regardless of UI toggle
# DELTA_LIVE_ENABLED=false
DELTA_LIVE_ORDER_MAX_SIZE=5
# Optional server-wide live override (use with extreme care):
# DELTA_LIVE_API_KEY=
# DELTA_LIVE_API_SECRET=
# DELTA_LIVE_PRODUCT_MAP_JSON={"BTCUSD":27}
# DELTA_LIVE_FALLBACK_PRODUCT_ID=27
