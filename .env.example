# Use a rotated MongoDB credential. Never commit the real URI.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/trading-book?retryWrites=true&w=majority

# Generate at least 32 random bytes, for example: openssl rand -base64 48
JWT_SECRET=replace-with-a-strong-random-secret

# Telegram Bot API token from @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=

# Destination chat for alerts. Supergroup/channel IDs from t.me/c/123 use -100123.
TELEGRAM_CHAT_ID=
