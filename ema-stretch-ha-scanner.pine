//@version=5
strategy("EMA Stretch Long + Short Reversal and HA Scanner", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, calc_on_every_tick=true, pyramiding=0)

//────────────────────────────────────────────
// STRATEGY SETTINGS
//────────────────────────────────────────────
strategyGroup = "Strategy Settings"

enableLong = input.bool(true, "Enable Long Trades", group=strategyGroup)
enableShort = input.bool(true, "Enable Short Trades", group=strategyGroup)

emaLen = input.int(5, "Fast EMA Length", minval=1, group=strategyGroup)
emaLen20 = input.int(20, "Slow EMA Length", minval=1, group=strategyGroup)
rr = input.float(1.5, "Risk-Reward Ratio", minval=0.1, step=0.1, group=strategyGroup)

//────────────────────────────────────────────
// HEIKIN ASHI ENTRY FILTERS
//────────────────────────────────────────────
filterGroup = "Heikin Ashi Entry Filters"

enableBodyFilter = input.bool(true, "Enable Minimum Body Filter", group=filterGroup)
minimumBodyPercent = input.float(50, "Minimum Body % of Range", minval=0, maxval=100, step=1, group=filterGroup)

enableEmaTouchFilter = input.bool(true, "Require EMA Touch / Directional Close", group=filterGroup)

avoidLongBottomWick = input.bool(false, "Avoid Long With Bottom Wick", group=filterGroup)
avoidShortTopWick = input.bool(false, "Avoid Short With Top Wick", group=filterGroup)

//────────────────────────────────────────────
// SCANNER SETTINGS
//────────────────────────────────────────────
scannerGroup = "Heikin Ashi Multi Pair Scanner"

confirmedOnly = input.bool(false, "Confirmed Closed Candle Only", group=scannerGroup)
slTpTimeframe = input.timeframe("", "SL/TP Column Timeframe (empty = chart)", group=scannerGroup)

enableGOLD = input.bool(true, "Enable GOLD", group=scannerGroup)
enableBTC = input.bool(true, "Enable BTC", group=scannerGroup)
enableETH = input.bool(true, "Enable ETH", group=scannerGroup)
enableSOL = input.bool(true, "Enable SOLUSD", group=scannerGroup)
enableXAG = input.bool(true, "Enable XAGUSD", group=scannerGroup)
enableOIL = input.bool(true, "Enable USOIL", group=scannerGroup)

goldSymbol = input.symbol("OANDA:XAUUSD", "GOLD Symbol", group=scannerGroup)
btcSymbol = input.symbol("BINANCE:BTCUSDT", "BTC Symbol", group=scannerGroup)
ethSymbol = input.symbol("BINANCE:ETHUSDT", "ETH Symbol", group=scannerGroup)
solSymbol = input.symbol("COINBASE:SOLUSD", "SOLUSD Symbol", group=scannerGroup)
xagSymbol = input.symbol("OANDA:XAGUSD", "XAGUSD Symbol", group=scannerGroup)
oilSymbol = input.symbol("TVC:USOIL", "USOIL Symbol", group=scannerGroup)

//────────────────────────────────────────────
// CHART EMA
//────────────────────────────────────────────
ema5 = ta.ema(close, emaLen)
ema20 = ta.ema(close, emaLen20)

//────────────────────────────────────────────
// COMMON HA CANDLE FILTER
//────────────────────────────────────────────
isBodyValid() =>
    candleRange = high - low
    bodySize = math.abs(close - open)
    bodyPercent = candleRange > 0 ? bodySize / candleRange * 100 : 0.0

    not enableBodyFilter or bodyPercent >= minimumBodyPercent

f_priceLabel(_price) =>
    str.tostring(_price, format.mintick)

f_slTpTableText(_side, _tp, _sl) =>
    _side + " | TP: " + f_priceLabel(_tp) + " | SL: " + f_priceLabel(_sl)

//────────────────────────────────────────────
// LONG SIGNAL
//────────────────────────────────────────────
getLongSignal(_ema) =>
    // Previous HA candle fully below EMA.
    candleANoTouch = high[1] < _ema[1]

    // Current HA candle breaks previous high.
    bullishBreak = high > high[1] and close > high[1]
    rawLongSignal = candleANoTouch and bullishBreak

    bodyValid = isBodyValid()

    // Touch/cross EMA or close above EMA.
    emaTouched = low <= _ema and high >= _ema
    emaValid = not enableEmaTouchFilter or emaTouched or close > _ema

    // Bottom wick check.
    bottomWick = math.min(open, close) - low
    hasBottomWick = bottomWick > syminfo.mintick
    wickValid = not avoidLongBottomWick or not hasBottomWick

    // Wait after raw reversal when EMA confirmation is missing.
    var bool waitingForLongEma = false
    bool finalLongSignal = false

    if rawLongSignal
        if emaValid
            finalLongSignal := bodyValid and wickValid
            waitingForLongEma := false
        else
            waitingForLongEma := true
    else if waitingForLongEma and emaValid
        if bodyValid and wickValid
            finalLongSignal := true
            waitingForLongEma := false

    finalLongSignal

//────────────────────────────────────────────
// SHORT SIGNAL
//────────────────────────────────────────────
getShortSignal(_ema) =>
    // Previous HA candle fully above EMA.
    candleANoTouch = low[1] > _ema[1]

    // Current HA candle breaks previous low.
    bearishBreak = low < low[1] and close < low[1]
    rawShortSignal = candleANoTouch and bearishBreak

    bodyValid = isBodyValid()

    // Touch/cross EMA or close below EMA.
    emaTouched = low <= _ema and high >= _ema
    emaValid = not enableEmaTouchFilter or emaTouched or close < _ema

    // Top wick check.
    topWick = high - math.max(open, close)
    hasTopWick = topWick > syminfo.mintick
    wickValid = not avoidShortTopWick or not hasTopWick

    // Wait after raw reversal when EMA confirmation is missing.
    var bool waitingForShortEma = false
    bool finalShortSignal = false

    if rawShortSignal
        if emaValid
            finalShortSignal := bodyValid and wickValid
            waitingForShortEma := false
        else
            waitingForShortEma := true
    else if waitingForShortEma and emaValid
        if bodyValid and wickValid
            finalShortSignal := true
            waitingForShortEma := false

    finalShortSignal

//────────────────────────────────────────────
// CURRENT CHART HA SIGNALS
//────────────────────────────────────────────
[longSignal, shortSignal] = request.security(
     ticker.heikinashi(syminfo.tickerid),
     timeframe.period,
     [
         getLongSignal(ta.ema(close, emaLen)),
         getShortSignal(ta.ema(close, emaLen))
     ],
     lookahead=barmerge.lookahead_off)

//────────────────────────────────────────────
// LONG AND SHORT STRATEGY
// Opposite entry automatically reverses position.
//────────────────────────────────────────────
if enableLong and longSignal and strategy.position_size <= 0
    longStop = low[1]
    longRisk = close - longStop

    if longRisk > syminfo.mintick
        longTarget = close + longRisk * rr

        strategy.entry(
             "Long",
             strategy.long,
             comment="LONG")

        strategy.exit(
             "Long TP/SL",
             from_entry="Long",
             stop=longStop,
             limit=longTarget)

else if enableShort and shortSignal and strategy.position_size >= 0
    shortStop = high[1]
    shortRisk = shortStop - close

    if shortRisk > syminfo.mintick
        shortTarget = close - shortRisk * rr

        strategy.entry(
             "Short",
             strategy.short,
             comment="SHORT")

        strategy.exit(
             "Short TP/SL",
             from_entry="Short",
             stop=shortStop,
             limit=shortTarget)

//────────────────────────────────────────────
// TODAY'S CLOSED-TRADE PERFORMANCE
//────────────────────────────────────────────
todayStart = time("D")

float todayProfit = 0.0
float todayLoss = 0.0
float todayNet = 0.0
int todayWins = 0
int todayLosses = 0

if strategy.closedtrades > 0
    for tradeIndex = 0 to strategy.closedtrades - 1
        tradeExitTime = strategy.closedtrades.exit_time(tradeIndex)

        if not na(todayStart) and tradeExitTime >= todayStart
            tradePnl = strategy.closedtrades.profit(tradeIndex)

            todayNet += tradePnl

            if tradePnl > 0
                todayProfit += tradePnl
                todayWins += 1
            else if tradePnl < 0
                todayLoss += math.abs(tradePnl)
                todayLosses += 1

formatMoney(_value) =>
    str.tostring(_value, "#.##")

//────────────────────────────────────────────
// HA SCANNER — signals + SL/TP in one call (TV 40-security limit)
//────────────────────────────────────────────
f_scannerRow() =>
    _ema = ta.ema(close, emaLen)
    longSig = confirmedOnly ? getLongSignal(_ema)[1] : getLongSignal(_ema)
    shortSig = confirmedOnly ? getShortSignal(_ema)[1] : getShortSignal(_ema)
    float stop = na
    float target = na

    if longSig
        stop := low[1]
        risk = close - stop
        target := risk > syminfo.mintick ? close + risk * rr : na
    else if shortSig
        stop := high[1]
        risk = stop - close
        target := risk > syminfo.mintick ? close - risk * rr : na

    [longSig, shortSig, stop, target]

getScannerRow(_symbol, _timeframe) =>
    request.security(
         ticker.heikinashi(_symbol),
         _timeframe,
         f_scannerRow(),
         lookahead=barmerge.lookahead_off)

slTpTf = slTpTimeframe == "" ? timeframe.period : slTpTimeframe

f_pickSlTpSlot(_tf, _m1, _m3, _m5, _m15, _m30, _h1) =>
    _tf == "1" ? _m1 :
         _tf == "3" ? _m3 :
         _tf == "5" ? _m5 :
         _tf == "15" ? _m15 :
         _tf == "30" ? _m30 :
         _tf == "60" ? _h1 :
         _m15

f_slTpCellText(_longSignal, _shortSignal, _stop, _target, _pairEnabled) =>
    scannerEnabled = _pairEnabled and (enableLong or enableShort)
    validLong = enableLong and _longSignal
    validShort = enableShort and _shortSignal
    hasLevels = not na(_stop) and not na(_target)

    not scannerEnabled
         ? "OFF"
         : (validLong or validShort) and hasLevels
             ? f_slTpTableText(validLong ? "LONG" : "SHORT", _target, _stop)
             : "-"

//────────────────────────────────────────────
// GOLD
//────────────────────────────────────────────
[goldM1Long, goldM1Short, goldM1Sl, goldM1Tp] = getScannerRow(goldSymbol, "1")
[goldM3Long, goldM3Short, goldM3Sl, goldM3Tp] = getScannerRow(goldSymbol, "3")
[goldM5Long, goldM5Short, goldM5Sl, goldM5Tp] = getScannerRow(goldSymbol, "5")
[goldM15Long, goldM15Short, goldM15Sl, goldM15Tp] = getScannerRow(goldSymbol, "15")
[goldM30Long, goldM30Short, goldM30Sl, goldM30Tp] = getScannerRow(goldSymbol, "30")
[goldH1Long, goldH1Short, goldH1Sl, goldH1Tp] = getScannerRow(goldSymbol, "60")

//────────────────────────────────────────────
// BTC
//────────────────────────────────────────────
[btcM1Long, btcM1Short, btcM1Sl, btcM1Tp] = getScannerRow(btcSymbol, "1")
[btcM3Long, btcM3Short, btcM3Sl, btcM3Tp] = getScannerRow(btcSymbol, "3")
[btcM5Long, btcM5Short, btcM5Sl, btcM5Tp] = getScannerRow(btcSymbol, "5")
[btcM15Long, btcM15Short, btcM15Sl, btcM15Tp] = getScannerRow(btcSymbol, "15")
[btcM30Long, btcM30Short, btcM30Sl, btcM30Tp] = getScannerRow(btcSymbol, "30")
[btcH1Long, btcH1Short, btcH1Sl, btcH1Tp] = getScannerRow(btcSymbol, "60")

//────────────────────────────────────────────
// ETH
//────────────────────────────────────────────
[ethM1Long, ethM1Short, ethM1Sl, ethM1Tp] = getScannerRow(ethSymbol, "1")
[ethM3Long, ethM3Short, ethM3Sl, ethM3Tp] = getScannerRow(ethSymbol, "3")
[ethM5Long, ethM5Short, ethM5Sl, ethM5Tp] = getScannerRow(ethSymbol, "5")
[ethM15Long, ethM15Short, ethM15Sl, ethM15Tp] = getScannerRow(ethSymbol, "15")
[ethM30Long, ethM30Short, ethM30Sl, ethM30Tp] = getScannerRow(ethSymbol, "30")
[ethH1Long, ethH1Short, ethH1Sl, ethH1Tp] = getScannerRow(ethSymbol, "60")

//────────────────────────────────────────────
// SOLUSD
//────────────────────────────────────────────
[solM1Long, solM1Short, solM1Sl, solM1Tp] = getScannerRow(solSymbol, "1")
[solM3Long, solM3Short, solM3Sl, solM3Tp] = getScannerRow(solSymbol, "3")
[solM5Long, solM5Short, solM5Sl, solM5Tp] = getScannerRow(solSymbol, "5")
[solM15Long, solM15Short, solM15Sl, solM15Tp] = getScannerRow(solSymbol, "15")
[solM30Long, solM30Short, solM30Sl, solM30Tp] = getScannerRow(solSymbol, "30")
[solH1Long, solH1Short, solH1Sl, solH1Tp] = getScannerRow(solSymbol, "60")

//────────────────────────────────────────────
// XAGUSD
//────────────────────────────────────────────
[xagM1Long, xagM1Short, xagM1Sl, xagM1Tp] = getScannerRow(xagSymbol, "1")
[xagM3Long, xagM3Short, xagM3Sl, xagM3Tp] = getScannerRow(xagSymbol, "3")
[xagM5Long, xagM5Short, xagM5Sl, xagM5Tp] = getScannerRow(xagSymbol, "5")
[xagM15Long, xagM15Short, xagM15Sl, xagM15Tp] = getScannerRow(xagSymbol, "15")
[xagM30Long, xagM30Short, xagM30Sl, xagM30Tp] = getScannerRow(xagSymbol, "30")
[xagH1Long, xagH1Short, xagH1Sl, xagH1Tp] = getScannerRow(xagSymbol, "60")

//────────────────────────────────────────────
// USOIL
//────────────────────────────────────────────
[oilM1Long, oilM1Short, oilM1Sl, oilM1Tp] = getScannerRow(oilSymbol, "1")
[oilM3Long, oilM3Short, oilM3Sl, oilM3Tp] = getScannerRow(oilSymbol, "3")
[oilM5Long, oilM5Short, oilM5Sl, oilM5Tp] = getScannerRow(oilSymbol, "5")
[oilM15Long, oilM15Short, oilM15Sl, oilM15Tp] = getScannerRow(oilSymbol, "15")
[oilM30Long, oilM30Short, oilM30Sl, oilM30Tp] = getScannerRow(oilSymbol, "30")
[oilH1Long, oilH1Short, oilH1Sl, oilH1Tp] = getScannerRow(oilSymbol, "60")

//────────────────────────────────────────────
// DASHBOARD COLORS
//────────────────────────────────────────────
headerBg = color.rgb(20, 20, 20)
pairBg = color.rgb(12, 12, 12)
longBg = color.rgb(0, 130, 70)
shortBg = color.rgb(170, 30, 30)
waitBg = color.rgb(145, 95, 20)
disabledBg = color.rgb(75, 75, 75)
profitBg = color.rgb(0, 90, 50)
lossBg = color.rgb(120, 25, 25)
whiteText = color.white

netBg = todayNet >= 0
     ? color.rgb(0, 70, 45)
     : color.rgb(100, 20, 20)

//────────────────────────────────────────────
// DASHBOARD
//────────────────────────────────────────────
var table scannerTable = table.new(
     position.top_right,
     8,
     10,
     bgcolor=pairBg,
     frame_color=color.gray,
     frame_width=1,
     border_color=color.rgb(55, 55, 55),
     border_width=1)

// Merge summary rows once.
var bool summaryMergedSlTp = false

if not summaryMergedSlTp
    table.merge_cells(scannerTable, 0, 7, 7, 7)
    table.merge_cells(scannerTable, 0, 8, 7, 8)
    table.merge_cells(scannerTable, 0, 9, 7, 9)
    summaryMergedSlTp := true

drawCell(_column, _row, _longSignal, _shortSignal, _pairEnabled) =>
    scannerEnabled = _pairEnabled and (enableLong or enableShort)
    validLong = enableLong and _longSignal
    validShort = enableShort and _shortSignal

    cellText = not scannerEnabled
         ? "OFF"
         : validLong
             ? "LONG"
             : validShort
                 ? "SHORT"
                 : "WAIT"

    cellBackground = not scannerEnabled
         ? disabledBg
         : validLong
             ? longBg
             : validShort
                 ? shortBg
                 : waitBg

    table.cell(
         scannerTable,
         _column,
         _row,
         cellText,
         text_color=whiteText,
         bgcolor=cellBackground,
         text_halign=text.align_center,
         text_size=size.tiny)

drawSlTpCell(_row, _longSignal, _shortSignal, _stop, _target, _pairEnabled) =>
    scannerEnabled = _pairEnabled and (enableLong or enableShort)
    validLong = enableLong and _longSignal
    validShort = enableShort and _shortSignal
    slTpText = f_slTpCellText(_longSignal, _shortSignal, _stop, _target, _pairEnabled)
    slTpBackground = not scannerEnabled
         ? disabledBg
         : validLong
             ? longBg
             : validShort
                 ? shortBg
                 : waitBg

    table.cell(
         scannerTable,
         7,
         _row,
         slTpText,
         text_color=whiteText,
         bgcolor=slTpBackground,
         text_halign=text.align_center,
         text_size=size.tiny)

drawRow(
     _row,
     _name,
     _enabled,
     _m1Long,
     _m1Short,
     _m3Long,
     _m3Short,
     _m5Long,
     _m5Short,
     _m15Long,
     _m15Short,
     _m30Long,
     _m30Short,
     _h1Long,
     _h1Short,
     _slLong,
     _slShort,
     _stop,
     _target) =>

    rowEnabled = _enabled and (enableLong or enableShort)

    table.cell(
         scannerTable,
         0,
         _row,
         _name,
         text_color=whiteText,
         bgcolor=rowEnabled ? pairBg : disabledBg,
         text_halign=text.align_center,
         text_size=size.tiny)

    drawCell(1, _row, _m1Long, _m1Short, _enabled)
    drawCell(2, _row, _m3Long, _m3Short, _enabled)
    drawCell(3, _row, _m5Long, _m5Short, _enabled)
    drawCell(4, _row, _m15Long, _m15Short, _enabled)
    drawCell(5, _row, _m30Long, _m30Short, _enabled)
    drawCell(6, _row, _h1Long, _h1Short, _enabled)
    drawSlTpCell(_row, _slLong, _slShort, _stop, _target, _enabled)

drawSummaryRow(_row, _label, _value, _background) =>
    table.cell(
         scannerTable,
         0,
         _row,
         _label + "  " + _value,
         text_color=whiteText,
         bgcolor=_background,
         text_halign=text.align_center,
         text_size=size.tiny)

//────────────────────────────────────────────
// DRAW DASHBOARD
//────────────────────────────────────────────
if barstate.islast
    table.cell(scannerTable, 0, 0, "PAIR", text_color=whiteText, bgcolor=headerBg, text_halign=text.align_center, text_size=size.tiny)
    table.cell(scannerTable, 1, 0, "M1", text_color=whiteText, bgcolor=headerBg, text_halign=text.align_center, text_size=size.tiny)
    table.cell(scannerTable, 2, 0, "M3", text_color=whiteText, bgcolor=headerBg, text_halign=text.align_center, text_size=size.tiny)
    table.cell(scannerTable, 3, 0, "M5", text_color=whiteText, bgcolor=headerBg, text_halign=text.align_center, text_size=size.tiny)
    table.cell(scannerTable, 4, 0, "M15", text_color=whiteText, bgcolor=headerBg, text_halign=text.align_center, text_size=size.tiny)
    table.cell(scannerTable, 5, 0, "M30", text_color=whiteText, bgcolor=headerBg, text_halign=text.align_center, text_size=size.tiny)
    table.cell(scannerTable, 6, 0, "H1", text_color=whiteText, bgcolor=headerBg, text_halign=text.align_center, text_size=size.tiny)
    table.cell(scannerTable, 7, 0, "SL/TP", text_color=whiteText, bgcolor=headerBg, text_halign=text.align_center, text_size=size.tiny)

    drawRow(
         1, "GOLD", enableGOLD,
         goldM1Long, goldM1Short,
         goldM3Long, goldM3Short,
         goldM5Long, goldM5Short,
         goldM15Long, goldM15Short,
         goldM30Long, goldM30Short,
         goldH1Long, goldH1Short,
         f_pickSlTpSlot(slTpTf, goldM1Long, goldM3Long, goldM5Long, goldM15Long, goldM30Long, goldH1Long),
         f_pickSlTpSlot(slTpTf, goldM1Short, goldM3Short, goldM5Short, goldM15Short, goldM30Short, goldH1Short),
         f_pickSlTpSlot(slTpTf, goldM1Sl, goldM3Sl, goldM5Sl, goldM15Sl, goldM30Sl, goldH1Sl),
         f_pickSlTpSlot(slTpTf, goldM1Tp, goldM3Tp, goldM5Tp, goldM15Tp, goldM30Tp, goldH1Tp))

    drawRow(
         2, "BTC", enableBTC,
         btcM1Long, btcM1Short,
         btcM3Long, btcM3Short,
         btcM5Long, btcM5Short,
         btcM15Long, btcM15Short,
         btcM30Long, btcM30Short,
         btcH1Long, btcH1Short,
         f_pickSlTpSlot(slTpTf, btcM1Long, btcM3Long, btcM5Long, btcM15Long, btcM30Long, btcH1Long),
         f_pickSlTpSlot(slTpTf, btcM1Short, btcM3Short, btcM5Short, btcM15Short, btcM30Short, btcH1Short),
         f_pickSlTpSlot(slTpTf, btcM1Sl, btcM3Sl, btcM5Sl, btcM15Sl, btcM30Sl, btcH1Sl),
         f_pickSlTpSlot(slTpTf, btcM1Tp, btcM3Tp, btcM5Tp, btcM15Tp, btcM30Tp, btcH1Tp))

    drawRow(
         3, "ETH", enableETH,
         ethM1Long, ethM1Short,
         ethM3Long, ethM3Short,
         ethM5Long, ethM5Short,
         ethM15Long, ethM15Short,
         ethM30Long, ethM30Short,
         ethH1Long, ethH1Short,
         f_pickSlTpSlot(slTpTf, ethM1Long, ethM3Long, ethM5Long, ethM15Long, ethM30Long, ethH1Long),
         f_pickSlTpSlot(slTpTf, ethM1Short, ethM3Short, ethM5Short, ethM15Short, ethM30Short, ethH1Short),
         f_pickSlTpSlot(slTpTf, ethM1Sl, ethM3Sl, ethM5Sl, ethM15Sl, ethM30Sl, ethH1Sl),
         f_pickSlTpSlot(slTpTf, ethM1Tp, ethM3Tp, ethM5Tp, ethM15Tp, ethM30Tp, ethH1Tp))

    drawRow(
         4, "SOLUSD", enableSOL,
         solM1Long, solM1Short,
         solM3Long, solM3Short,
         solM5Long, solM5Short,
         solM15Long, solM15Short,
         solM30Long, solM30Short,
         solH1Long, solH1Short,
         f_pickSlTpSlot(slTpTf, solM1Long, solM3Long, solM5Long, solM15Long, solM30Long, solH1Long),
         f_pickSlTpSlot(slTpTf, solM1Short, solM3Short, solM5Short, solM15Short, solM30Short, solH1Short),
         f_pickSlTpSlot(slTpTf, solM1Sl, solM3Sl, solM5Sl, solM15Sl, solM30Sl, solH1Sl),
         f_pickSlTpSlot(slTpTf, solM1Tp, solM3Tp, solM5Tp, solM15Tp, solM30Tp, solH1Tp))

    drawRow(
         5, "XAGUSD", enableXAG,
         xagM1Long, xagM1Short,
         xagM3Long, xagM3Short,
         xagM5Long, xagM5Short,
         xagM15Long, xagM15Short,
         xagM30Long, xagM30Short,
         xagH1Long, xagH1Short,
         f_pickSlTpSlot(slTpTf, xagM1Long, xagM3Long, xagM5Long, xagM15Long, xagM30Long, xagH1Long),
         f_pickSlTpSlot(slTpTf, xagM1Short, xagM3Short, xagM5Short, xagM15Short, xagM30Short, xagH1Short),
         f_pickSlTpSlot(slTpTf, xagM1Sl, xagM3Sl, xagM5Sl, xagM15Sl, xagM30Sl, xagH1Sl),
         f_pickSlTpSlot(slTpTf, xagM1Tp, xagM3Tp, xagM5Tp, xagM15Tp, xagM30Tp, xagH1Tp))

    drawRow(
         6, "USOIL", enableOIL,
         oilM1Long, oilM1Short,
         oilM3Long, oilM3Short,
         oilM5Long, oilM5Short,
         oilM15Long, oilM15Short,
         oilM30Long, oilM30Short,
         oilH1Long, oilH1Short,
         f_pickSlTpSlot(slTpTf, oilM1Long, oilM3Long, oilM5Long, oilM15Long, oilM30Long, oilH1Long),
         f_pickSlTpSlot(slTpTf, oilM1Short, oilM3Short, oilM5Short, oilM15Short, oilM30Short, oilH1Short),
         f_pickSlTpSlot(slTpTf, oilM1Sl, oilM3Sl, oilM5Sl, oilM15Sl, oilM30Sl, oilH1Sl),
         f_pickSlTpSlot(slTpTf, oilM1Tp, oilM3Tp, oilM5Tp, oilM15Tp, oilM30Tp, oilH1Tp))

    drawSummaryRow(
         7,
         "TODAY +",
         "+" + formatMoney(todayProfit) + " (" + str.tostring(todayWins) + ")",
         profitBg)

    drawSummaryRow(
         8,
         "TODAY -",
         "-" + formatMoney(todayLoss) + " (" + str.tostring(todayLosses) + ")",
         lossBg)

    drawSummaryRow(
         9,
         "NET",
         (todayNet >= 0 ? "+" : "") + formatMoney(todayNet),
         netBg)

//────────────────────────────────────────────
// CHART PLOTS
//────────────────────────────────────────────
plot(ema5, color=color.green, title="Fast EMA", linewidth=2)
plot(ema20, color=color.red, title="Slow EMA", linewidth=2)

plotshape(
     enableLong and longSignal,
     title="Long Signal",
     style=shape.labelup,
     location=location.belowbar,
     color=color.green,
     text="LONG",
     textcolor=color.white,
     size=size.tiny)

plotshape(
     enableShort and shortSignal,
     title="Short Signal",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     text="SHORT",
     textcolor=color.white,
     size=size.tiny)

//────────────────────────────────────────────
// ALERTS
//────────────────────────────────────────────
alertcondition(
     enableLong and longSignal,
     title="Bullish HA EMA Reversal",
     message="LONG Heikin Ashi EMA reversal on {{ticker}} {{interval}}")

alertcondition(
     enableShort and shortSignal,
     title="Bearish HA EMA Reversal",
     message="SHORT Heikin Ashi EMA reversal on {{ticker}} {{interval}}")
