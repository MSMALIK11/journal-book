# Must match MT5_WORKER_TOKEN on the JournalBook server.
MT5_WORKER_TOKEN=replace-with-a-long-random-token

# Optional. Full path to terminal64.exe when MetaTrader 5 is not in the default location.
# MT5_TERMINAL_PATH=C:\Program Files\XM Global MT5\terminal64.exe

# Optional. Seconds to wait for the terminal to answer a login request.
# MT5_LOGIN_TIMEOUT=30

# Local development only. Answers /login with a simulated success so the
# JournalBook UI flow can be tested without Windows. Ignored on any host where
# the real MetaTrader5 package is installed.
# MT5_ALLOW_FAKE_LOGIN=1
